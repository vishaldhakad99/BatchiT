# BatchiT Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/batchit
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Authentication Secrets (Replace in production)
JWT_ACCESS_SECRET=batchit_access_token_secret_min_32_characters_random
JWT_REFRESH_SECRET=batchit_refresh_token_secret_min_32_characters_random
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECURE=false

# Media Storage
MEDIA_STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=25

# Optional External Services
REDIS_URL=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=
